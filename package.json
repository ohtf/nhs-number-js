{
  "name": "@ohtf/nhs-number-js",
  "version": "0.1.1",
  "description": "Validate, standardise and classify NHS and Scottish CHI numbers in JavaScript and TypeScript.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohtf/nhs-number-js.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "LICENSES/CC-BY-SA-4.0.txt",
    "CONTRIBUTING.md",
    "SAFETY.md",
    "spec/standard.md",
    "tests/conformance/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
